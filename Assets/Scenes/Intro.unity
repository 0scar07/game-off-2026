  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fase.Intro
  picture: {fileID: 1757539464}
  pictureGroup: {fileID: 1757539461}
  subtitle: {fileID: 187962273}
  slides:
  - {fileID: 478399652945982905, guid: 7daa2ecf3e8fced4780e57952121433b, type: 3}
  - {fileID: -4190678503144803496, guid: eccfcad3f8091a4418998e6b5d542fb2, type: 3}
  - {fileID: -4297336201219199403, guid: c07edd823c3a604438aeb79863e7603c, type: 3}
  - {fileID: 7166508444039277278, guid: 4638cf85bc69561479fc287ded760836, type: 3}
  linesEs:
  - "Hubo un tiempo en que el d\xEDa y la noche compart\xEDan el mismo cielo."
  - "Pero una noche, la luna se rompi\xF3 en mil pedazos\u2026"
  - "\u2026y una grieta de luz parti\xF3 el mundo en dos."
  - "Lumi decidi\xF3 reunir los fragmentos. Solo ten\xEDa un farol\u2026 y la l\xEDnea."
  linesEn:
  - Once, day and night shared the same sky.
  - "But one night, the moon shattered into a thousand pieces\u2026"
  - "\u2026and a crack of light split the world in two."
  - "Lumi set out to gather the pieces, with only a lantern\u2026 and the line."
  secondsPerSlide: 5.5
  voiceEs:
  - {fileID: 8300000, guid: 0e1d02b499cc2dc48a6237ea58d5814d, type: 3}
  - {fileID: 8300000, guid: c298b1ca78eae694098990824ca35f88, type: 3}
